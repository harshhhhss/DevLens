PORT=5055
MONGO_URI=mongodb://127.0.0.1:27017/devlens
JWT_SECRET=replace_with_a_long_random_secret
GEMINI_API_KEY=your_gemini_api_key_here
CLIENT_URL=http://localhost:5173

# GitHub OAuth App (github.com/settings/developers). Placeholders only.
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5055/api/v1/github/callback
# Optional: narrow to public repositories only with public_repo
GITHUB_SCOPE=repo
# 64 hex characters, or any long passphrase. Encrypts stored GitHub tokens.
TOKEN_ENCRYPTION_KEY=replace_with_64_hex_chars_or_a_long_passphrase
